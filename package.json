  "keywords": ["web-components", "custom-elements", "games", "plinko", "slots", "mines", "crash", "play-money", "embed"],
  "license": "MIT",
  "homepage": "https://chiplets.dev",
  "repository": { "type": "git", "url": "git+https://github.com/Chiplets-Dev/chiplets.git" },
  "bugs": { "url": "https://github.com/Chiplets-Dev/chiplets/issues" },
  "type": "module",
  "main": "dist/chiplets.all.js",
  "unpkg": "dist/chiplets.all.js",
  "jsdelivr": "dist/chiplets.all.js",
  "sideEffects": true,
  "files": ["dist", "integrity.json", "CHANGELOG.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
